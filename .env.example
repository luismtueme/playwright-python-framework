# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every variable is optional. Environment variables override .env, which overrides
# config/test_config.json.

# --- Application under test ---------------------------------------------------
# Leave BASE_URL empty to run against the bundled demo app (started automatically).
BASE_URL=
# API base URL, if different from BASE_URL
API_BASE_URL=
# Label shown in the report (local, qa, staging, ...)
TEST_ENV=local

# Logins for each role the tests use. Not needed for the demo app.
# admin: full access
APP_USERNAME=
APP_PASSWORD=
# viewer: read-only
VIEWER_USERNAME=
VIEWER_PASSWORD=

# --- Browser and runner -------------------------------------------------------
# chromium | firefox | webkit
TEST_BROWSER=chromium
# A Playwright device name, e.g. "Pixel 7" or "iPhone 15" (overrides the desktop viewport). Empty: desktop
TEST_DEVICE=
# Defaults to true in CI, test_config.json "headless" locally
HEADLESS=
# Parallel workers (pytest-xdist). Default: 2 in CI, 1 locally. Set WORKERS=4 to opt in.
WORKERS=
# Retries for failed tests (default: 1 in CI, 0 locally)
RETRIES=
# off | on | retain-on-failure
VIDEO=retain-on-failure
TRACE=retain-on-failure
# Timeouts in milliseconds
ACTION_TIMEOUT=
NAVIGATION_TIMEOUT=
EXPECT_TIMEOUT=
TEST_TIMEOUT=

# --- Database (enables db tests when DB_HOST is set) --------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- API contract and test data -----------------------------------------------
# OpenAPI document (file path or URL) every API response is checked against.
# Defaults to contracts/openapi.yaml for the demo app; checks are off for a real
# app until this is set.
OPENAPI_SPEC=
# Seed for generated test data and property tests. A failed test's report shows
# the seed to use here to reproduce it exactly.
TEST_SEED=

# --- Reporting ----------------------------------------------------------------
# error | warn | info | debug (default: info in CI, warn locally)
LOG_LEVEL=
# Suite filter used by the runner: default (not quarantine, not visual), quarantine, visual, all
PW_SUITE=
